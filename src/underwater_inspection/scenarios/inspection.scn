<?xml version='1.0' encoding='utf-8'?>
<scenario>
  <environment>
    <ned latitude="41.7777" longitude="3.0333" />
    <ocean>
      <water density="1031.0" jerlov="0.1" temperature="15.0" />
      <particles enabled="true" />
      <waves height="0.0" />
      <current type="uniform">
        <velocity xyz="0.0 0.1 0.0" />
      </current>
    </ocean>
    <atmosphere>
      <sun azimuth="40.0" elevation="65.0" />
    </atmosphere>
  </environment>
  <include file="data/worlds/common/visual.scn" />
  <materials>
    <material name="Neutral" density="1000.0" restitution="0.1" />
    <material name="Rock" density="3000.0" restitution="0.8" />
    <material name="Fiberglass" density="1500.0" restitution="0.3" />
    <material name="Aluminium" density="2710.0" restitution="0.5" />
    <material name="Sand" density="1600.0" restitution="0.2" />
    <material name="Seabed" density="1800.0" restitution="0.2" />
    <material name="Concrete" density="2400.0" restitution="0.6" />
    <friction_table>
      <friction material1="Neutral" material2="Neutral" static="0.5" dynamic="0.2" />
      <friction material1="Neutral" material2="Rock" static="0.2" dynamic="0.1" />
      <friction material1="Neutral" material2="Fiberglass" static="0.5" dynamic="0.2" />
      <friction material1="Neutral" material2="Aluminium" static="0.1" dynamic="0.02" />
      <friction material1="Rock" material2="Rock" static="0.9" dynamic="0.7" />
      <friction material1="Rock" material2="Fiberglass" static="0.6" dynamic="0.4" />
      <friction material1="Rock" material2="Aluminium" static="0.6" dynamic="0.3" />
      <friction material1="Fiberglass" material2="Fiberglass" static="0.5" dynamic="0.2" />
      <friction material1="Fiberglass" material2="Aluminium" static="0.5" dynamic="0.2" />
      <friction material1="Aluminium" material2="Aluminium" static="0.8" dynamic="0.5" />
      <friction material1="Sand" material2="Sand" static="0.4" dynamic="0.3" />
      <friction material1="Sand" material2="Rock" static="0.5" dynamic="0.4" />
      <friction material1="Sand" material2="Fiberglass" static="0.4" dynamic="0.3" />
      <friction material1="Sand" material2="Aluminium" static="0.3" dynamic="0.2" />
      <friction material1="Seabed" material2="Seabed" static="0.6" dynamic="0.4" />
      <friction material1="Seabed" material2="Rock" static="0.7" dynamic="0.5" />
      <friction material1="Concrete" material2="Concrete" static="0.7" dynamic="0.5" />
    </friction_table>
    <material name="Steel" density="7850.0" restitution="0.1" />
  </materials>
  <looks>
    <look name="inspection_yellow" rgb="1.0 0.86 0.01" roughness="0.6" />
    <look name="inspection_red" rgb="0.9 0.03 0.02" roughness="0.4" />
    <look name="crate_brown" rgb="0.55 0.30 0.12" roughness="0.85" />
    <look name="dock_cyan" rgb="0.0 0.85 0.90" roughness="0.4" />
  </looks>
  <static name="seafloor" type="box">
    <dimensions xyz="30 18 0.3" />
    <material name="Concrete" />
    <look name="dark_sand" />
    <world_transform xyz="0 0 6.15" rpy="0 0 0" />
  </static>
  <static name="home_pad" type="box">
    <dimensions xyz="1.5 1.5 0.05" />
    <material name="Concrete" />
    <look name="dock_cyan" />
    <world_transform xyz="-5 0 5.97" rpy="0 0 0" />
  </static>
  <static name="pillar_main" type="cylinder">
    <dimensions radius="0.75" height="5.2" />
    <material name="Concrete" />
    <look name="gray" />
    <world_transform xyz="-1.3 0.0 3.3" rpy="0 0 0" />
  </static>
  <static name="pillar_side" type="cylinder">
    <dimensions radius="0.55" height="5.2" />
    <material name="Concrete" />
    <look name="gray" />
    <world_transform xyz="1.0 2.5 3.3" rpy="0 0 0" />
  </static>
  <static name="storage_crate" type="box">
    <dimensions xyz="1.1 1.1 4.0" />
    <material name="Concrete" />
    <look name="crate_brown" />
    <world_transform xyz="-3.0 -2.6 3.9" rpy="0 0 0" />
  </static>
  <static name="pipeline" type="cylinder">
    <dimensions radius="0.22" height="11.0" />
    <material name="Concrete" />
    <look name="gray" />
    <world_transform xyz="0 3.6 5.3" rpy="0 1.57079632679 0" />
  </static>
  <static name="panel_frame" type="box">
    <dimensions xyz="0.2 1.5 1.3" />
    <material name="Concrete" />
    <look name="gray" />
    <world_transform xyz="5.62 0.0 2.5" rpy="0 0 0" />
  </static>
  <static name="inspection_panel" type="box">
    <dimensions xyz="0.12 1.2 1.0" />
    <material name="Concrete" />
    <look name="inspection_yellow" />
    <world_transform xyz="5.5 0.0 2.5" rpy="0 0 0" />
  </static>
  <static name="valve" type="cylinder">
    <dimensions radius="0.18" height="0.15" />
    <material name="Concrete" />
    <look name="inspection_red" />
    <world_transform xyz="5.38 0.0 2.5" rpy="0 1.57079632679 0" />
  </static>
  <include file="$(find underwater_inspection)/scenarios/robot.scn">
    <arg name="vehicle_name" value="bluerov2" />
    <arg name="xyz" value="-5.0 0.0 2.5" />
    <arg name="rpy" value="0 0 0" />
  </include>
  <contact name="collision_seafloor">
    <first_body name="bluerov2/base_link" />
    <second_body name="seafloor" />
    <history points="1" />
    <ros_publisher topic="/inspection/contact/seafloor" />
  </contact>
  <contact name="collision_inspection_panel">
    <first_body name="bluerov2/base_link" />
    <second_body name="inspection_panel" />
    <history points="1" />
    <ros_publisher topic="/inspection/contact/inspection_panel" />
  </contact>
  <contact name="collision_panel_frame">
    <first_body name="bluerov2/base_link" />
    <second_body name="panel_frame" />
    <history points="1" />
    <ros_publisher topic="/inspection/contact/panel_frame" />
  </contact>
  <contact name="collision_pillar_main">
    <first_body name="bluerov2/base_link" />
    <second_body name="pillar_main" />
    <history points="1" />
    <ros_publisher topic="/inspection/contact/pillar_main" />
  </contact>
  <contact name="collision_pillar_side">
    <first_body name="bluerov2/base_link" />
    <second_body name="pillar_side" />
    <history points="1" />
    <ros_publisher topic="/inspection/contact/pillar_side" />
  </contact>
  <contact name="collision_storage_crate">
    <first_body name="bluerov2/base_link" />
    <second_body name="storage_crate" />
    <history points="1" />
    <ros_publisher topic="/inspection/contact/storage_crate" />
  </contact>
</scenario>